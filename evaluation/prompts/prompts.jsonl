# 朗读稿（虚构病例，不含任何真实患者信息）。spoken = 朗读文字；reference = 期望写入病历的文字；状态：草稿，待医生审核。
{"id": "r01", "specialty": "respiratory_critical_care", "spoken": "主诉，反复咳嗽、咳痰三年，加重一周，伴气促。", "reference": "主诉：反复咳嗽、咳痰3年，加重1周，伴气促。", "tags": ["field", "terms"]}
{"id": "r02", "specialty": "respiratory_critical_care", "spoken": "现病史，患者三年前无明显诱因出现咳嗽、咳痰，咳白色泡沫痰，痰量约五十毫升。", "reference": "现病史：患者3年前无明显诱因出现咳嗽、咳痰，咳白色泡沫痰，痰量约 50 mL。", "tags": ["field", "units"]}
{"id": "r03", "specialty": "respiratory_critical_care", "spoken": "查体，体温三十六点八摄氏度，脉搏八十次每分，呼吸二十次每分，血压一百二十八十毫米汞柱。", "reference": "查体：体温36.8℃，脉搏80次/分，呼吸20次/分，血压120/80mmHg。", "tags": ["field", "numbers", "vitals", "bp"]}
{"id": "r04", "specialty": "respiratory_critical_care", "spoken": "血氧饱和度百分之九十二，吸氧每分钟三升。", "reference": "血氧饱和度92%，吸氧 3 L/min。", "tags": ["numbers", "vitals"]}
{"id": "r05", "specialty": "respiratory_critical_care", "spoken": "双肺呼吸音粗，可闻及少量湿啰音，未闻及干啰音及哮鸣音。", "reference": "双肺呼吸音粗，可闻及少量湿啰音，未闻及干啰音及哮鸣音。", "tags": ["negation", "terms"]}
{"id": "r06", "specialty": "respiratory_critical_care", "spoken": "患者无发热，无胸痛，无咯血，无夜间阵发性呼吸困难。", "reference": "患者无发热，无胸痛，无咯血，无夜间阵发性呼吸困难。", "tags": ["negation"]}
{"id": "r07", "specialty": "respiratory_critical_care", "spoken": "动脉血气分析，pH七点三五，二氧化碳分压五十毫米汞柱，氧分压六十毫米汞柱。", "reference": "动脉血气分析：pH 7.35，二氧化碳分压 50mmHg，氧分压 60mmHg。", "tags": ["numbers", "gas"]}
{"id": "r08", "specialty": "respiratory_critical_care", "spoken": "氧合指数二百五十，考虑中度急性呼吸窘迫综合征。", "reference": "氧合指数 250，考虑中度急性呼吸窘迫综合征。", "tags": ["numbers", "terms"]}
{"id": "r09", "specialty": "respiratory_critical_care", "spoken": "予无创呼吸机辅助通气，吸入氧浓度百分之五十，呼气末正压五厘米水柱。", "reference": "予无创呼吸机辅助通气，吸入氧浓度 50%，呼气末正压 5 cmH2O。", "tags": ["numbers", "vent"]}
{"id": "r10", "specialty": "respiratory_critical_care", "spoken": "有创机械通气，潮气量四百五十毫升，呼吸频率十六次每分，平台压二十五厘米水柱。", "reference": "有创机械通气，潮气量 450 mL，呼吸频率16次/分，平台压 25 cmH2O。", "tags": ["numbers", "vent"]}
{"id": "r11", "specialty": "respiratory_critical_care", "spoken": "胸部CT提示右肺上叶磨玻璃结节，直径八毫米，纵隔淋巴结肿大。", "reference": "胸部CT提示右肺上叶磨玻璃结节，直径 8 mm，纵隔淋巴结肿大。", "tags": ["numbers", "terms"]}
{"id": "r12", "specialty": "respiratory_critical_care", "spoken": "甲泼尼龙四十毫克，每日一次，静脉滴注。", "reference": "甲泼尼龙 40 mg qd，静脉滴注。", "tags": ["drugs", "numbers"]}
{"id": "o01", "specialty": "orthopedics", "spoken": "主诉，摔伤后左髋部疼痛伴活动受限两小时。", "reference": "主诉：摔伤后左髋部疼痛伴活动受限2小时。", "tags": ["field", "terms"]}
{"id": "o02", "specialty": "orthopedics", "spoken": "专科检查，左髋部压痛，叩击痛阳性，左下肢外旋畸形，纵向叩击痛阳性。", "reference": "专科检查：左髋部压痛，叩击痛阳性，左下肢外旋畸形，纵向叩击痛阳性。", "tags": ["field", "negation", "terms"]}
{"id": "o03", "specialty": "orthopedics", "spoken": "左膝关节肿胀，浮髌试验阳性，屈曲一百二十度，伸直零度。", "reference": "左膝关节肿胀，浮髌试验阳性，屈曲120°，伸直0°。", "tags": ["rom", "negation"]}
